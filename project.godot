; Engine configuration file.
config_version=5

[application]

config/name="İnşa"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

PaintedLookHook="*res://scripts/painted_look.gd"

[physics]

common/physics_ticks_per_second=120
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
limits/global_shader_variables/buffer_size=262144

[gui]

theme/custom_font="res://assets/fonts/Barlow-Medium.ttf"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="vehicle"

[shader_globals]

grass_press={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0)
}

weather_wetness={
"type": "float",
"value": 0.0
}
weather_snow={
"type": "float",
"value": 0.0
}
props_lod_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
weather_ice={
"type": "float",
"value": 0.0
}
weather_rain={
"type": "float",
"value": 0.0
}
weather_daylight={
"type": "float",
"value": 1.0
}
weather_wind={
"type": "vec3",
"value": Vector3(0.6, 0.3, 0.4)
}
campfire_clear_a={
"type": "vec4",
"value": Vector4(1e+06, 0, 1e+06, 0)
}
campfire_clear_b={
"type": "vec4",
"value": Vector4(1e+06, 0, 1e+06, 0)
}

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="disabled"
