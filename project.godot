; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Last Verst"
config/description="Bir vadide köy kurma ve yönetme oyunu."
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/İnşa"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[gui]

theme/custom_font="res://assets/fonts/OldStandard-Regular.ttf"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="buildings"
3d_physics/layer_3="debris"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
limits/global_shader_variables/buffer_size=262144

[shader_globals]

grass_press={
"type": "vec4",
"value": Vector4(0, -1000, 0, 0)
}
view_focus={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
weather_wetness={
"type": "float",
"value": 0.0
}
season_autumn={
"type": "float",
"value": 0.0
}
season_flowers={
"type": "float",
"value": 0.0
}
season_bare={
"type": "float",
"value": 0.0
}
water_frozen={
"type": "float",
"value": 0.0
}
weather_snow={
"type": "float",
"value": 0.0
}
props_lod_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
weather_ice={
"type": "float",
"value": 0.0
}
weather_rain={
"type": "float",
"value": 0.0
}
weather_daylight={
"type": "float",
"value": 1.0
}
weather_wind={
"type": "vec3",
"value": Vector3(0.6, 0.3, 0.4)
}
campfire_clear_a={
"type": "vec4",
"value": Vector4(1000000, 0, 1000000, 0)
}
campfire_clear_b={
"type": "vec4",
"value": Vector4(1000000, 0, 1000000, 0)
}
